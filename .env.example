# Public build configuration. These values are intentionally not secrets.
# Netlify must provide the first two values for every production and deploy-preview build.
VITE_SANITY_PROJECT_ID=your-sanity-project-id
VITE_SANITY_DATASET=production

# Required by the nested Studio package. Use the same public project and dataset values.
SANITY_STUDIO_PROJECT_ID=your-sanity-project-id
SANITY_STUDIO_DATASET=production

# Local visual checks only. Never set this in Netlify.
# VITE_CONTENT_SOURCE=fixtures
